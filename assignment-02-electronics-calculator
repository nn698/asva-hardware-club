#include <iostream>
#include <string>
using namespace std;

int main() {
   string name;
   double voltage , resistance;
   cout<< "Input your Name: ";
   cin>> name;
   cout<< "Name:" << name<<endl;
   cout<< "Input your Voltage Value: "<<endl;
   cin>> voltage;
   cout<< "Input your Resistance Value: "<<endl;
